{
  "name": "@arvarus/basic-rules-engine",
  "version": "4.0.0",
  "description": "rule engine",
  "main": "bin/index.js",
  "types": "bin/index.d.ts",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "default": "./bin/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "GPL-3.0-only",
  "files": [
    "bin",
    "!bin/*.test.*",
    "!bin/.tsbuildinfo",
    "gpl-3.0.txt"
  ],
  "scripts": {
    "compile": "tsc -b tsconfig.build.json",
    "compile:clean": "tsc -b tsconfig.build.json --clean",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run compile",
    "test": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvarus/basic-rules-engine.git"
  },
  "type": "module",
  "overrides": {
    "brace-expansion": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
